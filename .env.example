# ForgeMind Environment Configuration
APP_ENV=development
APP_NAME=ForgeMind
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For PostgreSQL with Docker:
# DATABASE_URL=postgresql+psycopg://forgemind:forgemind@localhost:5432/forgemind
# For zero-Docker local single-file SQLite database:
DATABASE_URL=sqlite:///forgemind.db

# Qdrant Vector DB Configuration
# Use http://localhost:6333 if running Qdrant via Docker, or 'memory' / local path for standalone local mode
QDRANT_URL=memory
QDRANT_COLLECTION=forgemind_maintenance

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173

# ML & Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RANDOM_SEED=42
DEMO_MODE=true

# Optional LLM Configuration (Deterministic fallback active when 'none')
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
